{
  "name": "dsh-hirame",
  "description": "Syncing memory across harnesses through plain files.",
  "version": "0.1.5",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "test/**/*.mjs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.mjs\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "agent-memory",
    "markdown",
    "zcode",
    "claude-code"
  ],
  "author": "AkutaZehy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkutaZehy/dsh-hirame.git"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  }
}